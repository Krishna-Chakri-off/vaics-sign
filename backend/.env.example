DATABASE_URL=sqlite:///./cms.db
# DATABASE_URL=postgresql+psycopg2://cms:cms@localhost:5432/cms
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=720
CORS_ORIGINS=http://localhost:5175,http://127.0.0.1:5175,http://192.168.20.51:5175
# AI assistant: none (rule-based fallback) or openai (any OpenAI-compatible endpoint)
AI_PROVIDER=none
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
# Email notifications (optional)
# Email via SMTP. Amazon SES (Mumbai) example – leave SMTP_HOST empty to use the in-app DEV EMAIL OUTBOX instead.
# SMTP_HOST=email-smtp.ap-south-1.amazonaws.com
SMTP_HOST=
SMTP_PORT=587
# SES SMTP credentials (IAM SMTP user) – NOT your AWS console login. Never commit real values.
SMTP_USER=<ses-smtp-username>
SMTP_PASSWORD=<ses-smtp-password>
SMTP_FROM=smart.servicedesk@vaics-consulting.com
WEBHOOKS_ENABLED=true

# --- VAICS Sign (all optional; defaults shown) ---
SIGN_ORG_NAME=VAICS Consulting
SIGN_PRODUCT_NAME=VAICS Sign
SIGN_PRIMARY_COLOR=#0D47A1
SIGN_ACCENT_COLOR=#E6007E
SIGN_LOGO_URL=/vaics-logo-full.png
SIGN_STORAGE_DIR=./sign_storage
SIGN_MAX_UPLOAD_MB=15
SIGN_LINK_EXPIRY_DAYS=7
# Base URL of the frontend, used to build signing links
SIGN_PUBLIC_BASE_URL=http://localhost:5175
SIGN_CODE_LENGTH=6
SIGN_CODE_MAX_ATTEMPTS=5
SIGN_CODE_EXPIRY_HOURS=72
SIGN_SESSION_MINUTES=30
# true only for implicit-TLS port 465; SES on 587 uses STARTTLS (false)
SIGN_SMTP_SSL=false
# Signing emails use SMTP_* above. If SMTP_HOST is empty, NO email is sent; emails (incl. access codes) appear in the DEV EMAIL OUTBOX page.
