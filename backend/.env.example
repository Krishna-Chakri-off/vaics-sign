# VAICS Sign backend environment. Copy to .env and fill in. NEVER commit real secrets.
# Every variable is optional in development; production MUST set SECRET_KEY, DATABASE_URL, PUBLIC_APP_URL and SMTP_*.

# development | test | production
ENV=development
# Phase 1 internal VAICS mode. true re-enables public sign-up, billing and the platform console (SaaS).
SAAS_MODE=false
APP_NAME=VAICS Sign
DATABASE_URL=sqlite:///./vaics_sign.db
SECRET_KEY=<set-in-secret-manager>
# frontend base URL used in emails
PUBLIC_APP_URL=http://localhost:5175
PUBLIC_API_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:5175,http://127.0.0.1:5175
CORS_ORIGIN_REGEX=http://(localhost|127\.0\.0\.1|192\.168\.\d+\.\d+|10\.\d+\.\d+\.\d+):\d+
# dev convenience; production uses `alembic upgrade head`
AUTO_CREATE_TABLES=true
# background reminders/expiry/retention loop inside the API process
RUN_SCHEDULER=false
SCHEDULER_INTERVAL_SECONDS=300
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=12
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15
EMAIL_TOKEN_HOURS=24
RESET_TOKEN_MINUTES=30
INVITE_DAYS=7
# k-anonymity check against haveibeenpwned (network)
HIBP_CHECK=false
BRAND_PRODUCT_NAME=VAICS Sign
BRAND_ORG_NAME=VAICS Consulting
# 0D47A1"
BRAND_PRIMARY=#0D47A1
# E6007E"
BRAND_ACCENT=#E6007E
BRAND_LOGO_URL=/vaics-logo-full.png
MAX_DOC_MB=25
MAX_ENVELOPE_MB=100
MAX_DOCS_PER_ENVELOPE=50
# LibreOffice for Word/Excel/PowerPoint/text/image -> PDF
SOFFICE_PATH=soffice
# malware scanning via clamd; empty = not configured
CLAMD_HOST=
CLAMD_PORT=3310
# local | s3
STORAGE_BACKEND=local
STORAGE_DIR=./storage
S3_BUCKET_IN=
S3_BUCKET_EU=
S3_BUCKET_US=
S3_REGION_IN=ap-south-1
S3_REGION_EU=eu-central-1
S3_REGION_US=us-east-1
# e.g. MinIO for local testing
S3_ENDPOINT_URL=
# >0 applies COMPLIANCE retention to completed docs (bucket must have Object Lock)
S3_OBJECT_LOCK_DAYS=0
LINK_EXPIRY_DAYS=120
ACCESS_CODE_LENGTH=6
CODE_MAX_ATTEMPTS=5
ACCESS_CODE_EXPIRY_HOURS=72
OTP_MINUTES=10
SIGNER_SESSION_MINUTES=30
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=<ses-smtp-username>
SMTP_PASSWORD=<ses-smtp-password>
SMTP_FROM=no-reply@example.com
SMTP_SSL=false
EMAIL_ATTACH_MAX_MB=9
# dev (outbox only) | twilio | msg91
SMS_PROVIDER=dev
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
BILLING_PROVIDER_IN=razorpay
BILLING_PROVIDER_INTL=stripe
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
TRIAL_DAYS=14
TRIAL_PLAN=business
SELLER_GSTIN=
# Telangana
SELLER_STATE_CODE=36
# PKCS#12 document-signing certificate for PAdES seal
SEAL_CERT_P12_PATH=
SEAL_CERT_P12_PASSWORD=
# RFC 3161 timestamp authority
SEAL_TSA_URL=
# dev only: generate a self-signed seal cert (NOT trusted by readers)
SEAL_DEV_SELF_SIGNED=true
# Aadhaar eSign (CCA-empanelled ESP)
ESIGN_ESP_URL=
ESIGN_ASP_ID=
DSC_PROVIDER_URL=
QTSP_PROVIDER_URL=
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PUBLIC_PER_MIN=120
RATE_LIMIT_AUTH_PER_MIN=20

# Amazon SES (Mumbai) example: SMTP_HOST=email-smtp.ap-south-1.amazonaws.com SMTP_PORT=587 SMTP_FROM=smart.servicedesk@vaics-consulting.com
# Leave SMTP_HOST empty to keep every email (including access codes) in the DEV EMAIL OUTBOX; nothing is delivered.
