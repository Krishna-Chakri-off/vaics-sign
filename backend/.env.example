# VAICS Sign backend environment template. Copy to .env. Placeholders only - NEVER put real secrets here.

# ---- App / URLs ----
ENV=development
APP_NAME=VAICS Sign
PUBLIC_APP_URL=http://localhost:5173
PUBLIC_API_URL=http://localhost:8000
AUTO_CREATE_TABLES=true
RUN_SCHEDULER=false
SCHEDULER_INTERVAL_SECONDS=300

# ---- CORS ----
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ORIGIN_REGEX=http://(localhost|127\.0\.0\.1|192\.168\.\d+\.\d+|10\.\d+\.\d+\.\d+):\d+

# ---- Security / sessions (JWT signed with SECRET_KEY) ----
SECRET_KEY=CHANGE_ME
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=12
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15
EMAIL_TOKEN_HOURS=24
RESET_TOKEN_MINUTES=30
INVITE_DAYS=7
HIBP_CHECK=false
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PUBLIC_PER_MIN=120
RATE_LIMIT_AUTH_PER_MIN=20

# ---- Database ----
DATABASE_URL=sqlite:///./vaics_sign.db

# ---- Branding defaults ----
BRAND_PRODUCT_NAME=VAICS Sign
BRAND_ORG_NAME=VAICS Consulting
BRAND_PRIMARY=#0D47A1
BRAND_ACCENT=#E6007E
BRAND_LOGO_URL=/vaics-logo-full.png

# ---- Documents / upload limits / malware scan ----
MAX_DOC_MB=25
MAX_ENVELOPE_MB=100
MAX_DOCS_PER_ENVELOPE=50
CLAMD_HOST=
CLAMD_PORT=3310

# ---- Storage (local | s3) ----
STORAGE_BACKEND=local
STORAGE_DIR=./storage
S3_BUCKET_IN=
S3_BUCKET_EU=
S3_BUCKET_US=
S3_REGION_IN=ap-south-1
S3_REGION_EU=eu-central-1
S3_REGION_US=us-east-1
S3_ENDPOINT_URL=
S3_OBJECT_LOCK_DAYS=0

# ---- Signing links / access codes ----
LINK_EXPIRY_DAYS=120
ACCESS_CODE_LENGTH=6
CODE_MAX_ATTEMPTS=5
ACCESS_CODE_EXPIRY_HOURS=72
OTP_MINUTES=10
SIGNER_SESSION_MINUTES=30

# ---- Signing seal (PAdES p12) - dev self-signed until a real cert is given ----
SEAL_CERT_P12_PATH=
SEAL_CERT_P12_PASSWORD=
SEAL_TSA_URL=
SEAL_DEV_SELF_SIGNED=true

# ---- Email / Amazon SES SMTP (ap-south-1). SMTP_HOST EMPTY = local outbox only, nothing is sent.
# When real SES is given: SMTP_HOST=email-smtp.ap-south-1.amazonaws.com, SMTP_PORT=587, SMTP_USER/SMTP_PASSWORD = SES SMTP credentials ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=<set-later>
SMTP_SSL=false
EMAIL_ATTACH_MAX_MB=9

# ---- SMS (dev = outbox only; not used in Phase 1) ----
SMS_PROVIDER=dev
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=

# ---- Trust providers (not used in Phase 1) ----
ESIGN_ESP_URL=
ESIGN_ASP_ID=
DSC_PROVIDER_URL=
QTSP_PROVIDER_URL=


# ---- Reserved for later (NOT read by the app yet; fill when wired) ----
# AWS SES API alternative (region ap-south-1). Keep blank until real details are shared.
# AWS_REGION=ap-south-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# EMAIL_FROM=<set-later>
# Portal SSO (IMS way) - placeholders only
# SSO_ENABLED=false
# SSO_ISSUER_URL=CHANGE_ME
# SSO_CLIENT_ID=CHANGE_ME
# SSO_CLIENT_SECRET=
# SSO_REDIRECT_URI=http://localhost:5173/auth/callback
# Retention: configured in Settings & branding (DB, audit-logged), default 3650 days - no env var.
# Seed only (shell env, not .env): DEMO_PASSWORD
