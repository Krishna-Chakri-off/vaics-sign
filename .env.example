# docker-compose variables. Copy to .env, then append backend/.env.example values you need.
POSTGRES_USER=vaics
POSTGRES_PASSWORD=<choose-a-strong-password>
POSTGRES_DB=vaics_sign
PUBLIC_APP_URL=http://localhost:8080
SECRET_KEY=<generate: python -c "import secrets;print(secrets.token_urlsafe(48))">
DEMO_PASSWORD=<choose-a-demo-password>
MINIO_ROOT_PASSWORD=<only-if-using-s3-profile>
